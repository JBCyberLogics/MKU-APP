<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Student Portal & General MKU domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">mku.ac.ke</domain>
        <pin-set expiration="2026-11-04">
            <pin digest="SHA-256">AYajYaKzuz3YSRwertDDgzz5l1Pkv+arBvmnzwucOjw=</pin>
            <pin digest="SHA-256">8kGWrpQHhmc0jwLo43RYo6bmqtHgsNxhARjM5yFCe/w=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="@raw/godaddy_intermediate" />
            <certificates src="@raw/mku_chain" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- VLMS Specific Configuration -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">vlms.mku.ac.ke</domain>
        <pin-set expiration="2026-12-31">
            <pin digest="SHA-256">5Wlm2T4vQVshZI+gi4W1hTXnn+mZMUYU1i2Avq7VVas=</pin>
            <pin digest="SHA-256">nWN7PSep5XDQdge5zK24CnCRXHr3KvzhKEGxsdqCX9E=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="@raw/vlms_chain" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
